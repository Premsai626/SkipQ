# ==============================================================================
# SKIPQ — ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-secure-jwt-secret-key

# Administrative Bootstrap Secret (Required to bootstrap the initial admin account)
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-secret

# Database & Storage Drivers ('supabase' | 'local')
DATABASE_DRIVER=supabase
STORAGE_DRIVER=supabase

# Supabase Project Credentials (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_STORAGE_BUCKET=xerox-documents
