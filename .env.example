# ==============================================================================
# SKIPQ — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Production / Local .env)
# ------------------------------------------------------------------------------
# In local development, leaving VITE_API_URL unset uses the Vite proxy (/api/v1).
# On Vercel, set this to your deployed Render backend API URL:
VITE_API_URL=https://your-backend-service.onrender.com/api/v1

# Supabase Client Credentials (Public Anon Key only — never expose service role keys to client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Production / backend/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production
# In production, JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace-with-a-unique-production-secret-min-32-chars

# Database & Storage Drivers ('supabase' | 'local')
DATABASE_DRIVER=supabase
STORAGE_DRIVER=supabase

# Supabase Project Credentials (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_STORAGE_BUCKET=xerox-documents

# CORS Origin (Set to your deployed Vercel domain in production)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Google Gemini AI Integration (Strictly server-side)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
