{
  "family": "xerox-flow-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/xeroxFlowAppRole",
  "containerDefinitions": [
    {
      "name": "xerox-flow-container",
      "image": "123456789012.dkr.ecr.ap-south-1.amazonaws.com/xerox-flow:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "80" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "DYNAMODB_ORDERS_TABLE", "value": "XeroxFlow_Orders" },
        { "name": "S3_DOCUMENT_BUCKET", "value": "xerox-flow-documents-campus" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/xerox-flow",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      }
    }
  ]
}
