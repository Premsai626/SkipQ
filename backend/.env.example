# ==============================================================================
# SKIPQ / XEROXFLOW — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5001
NODE_ENV=production

# JWT Authentication (In production, must be at least 32 characters long)
JWT_SECRET=replace-with-a-unique-production-secret-min-32-chars

# Database & Storage Drivers: 'supabase' | 'local'
DATABASE_DRIVER=supabase
STORAGE_DRIVER=supabase

# Supabase Credentials (from your Supabase Dashboard: Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use your service_role secret key for backend API access (bypasses RLS safely)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Anon public key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Storage bucket for uploaded documents
SUPABASE_STORAGE_BUCKET=xerox-documents

# CORS Configuration: Set to your production Vercel frontend URL
FRONTEND_URL=https://your-frontend-app.vercel.app

# Google Gemini AI Integration (Strictly server-side)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
